{
  "text_cleaning": {
    "drop_line_patterns": [
      "^(?:首页|登录|注册|搜索|打印本页|打印|分享|收藏|返回顶部|网站地图|联系我们|关于我们)$",
      "^(?:关注[:：]?|登录(?:邮箱系统)?|学习新时代|机构设置|法院资讯|权威发布|公报|审判业务|法院建设|办事服务|公众互动|巡回法庭|典型案例发布)$",
      "^(?:字号|小|中|大|关闭|展开|收起)$",
      "^(?:当前位置|所在位置)[:：]?.{0,120}$",
      "^(?:来源|发布时间|发布者|责任编辑|编辑)[:：].{0,160}$",
      "^(?:中文版|English|EN|繁體中文)$",
      "^(?:版权声明|隐私政策|使用条款|Cookie(?: Policy)?)$",
      "^(?:上一页|下一页|上一篇|下一篇|返回列表)$",
      "^第?\\s*\\d+\\s*(?:页|/\\s*\\d+)?$"
    ],
    "drop_inline_patterns": [
      "<[^>]{1,200}>",
      "\\[\\s*(?:中文版|English|EN)\\s*\\]"
